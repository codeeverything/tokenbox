# Shared look for every recording, at 2x so captures stay sharp on retina screens.
# Colours match the site palette.
Set Shell "bash"
Set FontFamily "Menlo"
Set FontSize 30
Set LineHeight 1.25
Set Padding 56
Set Margin 0
Set WindowBar Colorful
Set WindowBarSize 72
Set BorderRadius 20
Set TypingSpeed 45ms
Set Theme { "name": "tokenbox", "background": "#17162A", "foreground": "#E4E2F3", "cursor": "#A9ACF0", "selection": "#34325A", "black": "#1B1A30", "red": "#F2675C", "green": "#4FD39A", "yellow": "#F2B84B", "blue": "#8F93EC", "magenta": "#C99AF0", "cyan": "#6FD3E0", "white": "#E4E2F3", "brightBlack": "#7F7DA0", "brightRed": "#FF8A80", "brightGreen": "#7BE6B5", "brightYellow": "#FFD27A", "brightBlue": "#B3B6FF", "brightMagenta": "#E0BBFF", "brightCyan": "#9BE8F2", "brightWhite": "#FFFFFF" }
