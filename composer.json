{
    "name": "tokenbox/tokenbox",
    "description": "See, check, refresh and create your Composer auth tokens across every repo and account.",
    "type": "composer-plugin",
    "license": "MIT",
    "bin": [
        "bin/tokenbox"
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "composer-plugin-api": "^2.0",
        "symfony/console": "^7.1",
        "laravel/prompts": "^0.3"
    },
    "autoload": {
        "psr-4": {
            "Tokenbox\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "composer/composer": "^2.8"
    },
    "extra": {
        "class": "Tokenbox\\Composer\\Plugin"
    }
}
